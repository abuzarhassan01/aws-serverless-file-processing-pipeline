{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "AllowS3ReadRawFiles",
            "Effect": "Allow",
            "Action": [
                "s3:GetObject"
            ],
            "Resource": "arn:aws:s3:::YOUR-BUCKET-NAME/input/*"
        },
        {
            "Sid": "AllowS3WriteProcessedFiles",
            "Effect": "Allow",
            "Action": [
                "s3:PutObject"
            ],
            "Resource": "arn:aws:s3:::YOUR-BUCKET-NAME/processed/*"
        }
    ]
}
